        }

        // CATEGORY FILTERING LOGIC
        function setCategory(category) {
            currentCategoryFilter = category;
            
            // Toggle active state styling on buttons
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.getAttribute('data-category') === category) {
                    btn.className = "cat-btn active bg-gray-900 text-white px-4 py-1.5 rounded-full text-xs md:text-sm font-medium transition shadow-sm";
                } else {
                    btn.className = "cat-btn bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-1.5 rounded-full text-xs md:text-sm font-medium transition";
                }
            });

            renderProducts();
        }

        // SEARCH FUNCTIONALITY
        function filterProducts() {
            renderProducts();
        }
        function filterProductsMobile() {
            renderProducts();
        }
        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('searchInputMobile').value = '';
            setCategory('semua');
        }

        // CART LOGIC
        function addToCart(productId) {
            const prod = products.find(p => p.id === productId);
            if (!prod || prod.stock <= 0) return;

            const existingIndex = cart.findIndex(item => item.id === productId);
            if (existingIndex > -1) {
                if (cart[existingIndex].qty < prod.stock) {
                    cart[existingIndex].qty += 1;
                } else {
                    showToast("Jumlah melebihi stok yang tersedia!", "warning");
                    return;
                }
            } else {
                cart.push({
                    id: prod.id,
                    name: prod.name,
                    brand: prod.brand,
                    price: prod.promoPrice || prod.price,
                    qty: 1,
                    sizeSelected: prod.sizes[0] || 'All Size'
                });
            }

            updateCartUI();
            showToast(`"${prod.name}" ditambahkan ke keranjang!`, "success");
        }

        function updateCartQty(productId, delta) {
            const cartItem = cart.find(item => item.id === productId);
            const prod = products.find(p => p.id === productId);

            if (cartItem && prod) {
                const newQty = cartItem.qty + delta;
                if (newQty <= 0) {
                    cart = cart.filter(item => item.id !== productId);
                } else if (newQty <= prod.stock) {
                    cartItem.qty = newQty;
                } else {
                    showToast("Mencapai batas maksimum stok produk!", "warning");
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            const countBadge = document.getElementById('cartCountBadge');
            const cartItemList = document.getElementById('cartItemList');
            const cartTotalPrice = document.getElementById('cartTotalPrice');

            const totalQty = cart.reduce((acc, item) => acc + item.qty, 0);
            countBadge.innerText = totalQty;

            cartItemList.innerHTML = '';

            if (cart.length === 0) {
                cartItemList.innerHTML = `
                    <div class="text-center py-10">
                        <i class="fa-solid fa-cart-arrow-down text-4xl text-gray-300 mb-2"></i>
                        <p class="text-gray-500 font-semibold text-sm">Keranjang Anda masih kosong.</p>
                        <p class="text-xs text-gray-400">Pilih baju favorit Anda di etalase kami.</p>
                    </div>
                `;
                cartTotalPrice.innerText = 'Rp 0';
                return;
            }

            let grandTotal = 0;

            cart.forEach(item => {
                const itemTotal = item.price * item.qty;
                grandTotal += itemTotal;

                const itemRow = document.createElement('div');
                itemRow.className = "flex items-center justify-between p-3 bg-gray-50 rounded-2xl border border-gray-200 gap-3";
                itemRow.innerHTML = `
                    <div class="flex-1">
                        <h5 class="font-bold text-gray-900 text-xs sm:text-sm line-clamp-1">${item.name}</h5>
                        <p class="text-[11px] text-gray-500">Merek: ${item.brand} | Ukuran: <span class="font-bold text-gray-700">${item.sizeSelected}</span></p>
                        <span class="text-xs font-black text-rose-600">Rp ${item.price.toLocaleString('id-ID')}</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="flex items-center border bg-white rounded-xl overflow-hidden">
                            <button onclick="updateCartQty(${item.id}, -1)" class="px-2.5 py-1 text-xs font-bold bg-gray-100 hover:bg-gray-200">-</button>
                            <span class="px-3 text-xs font-bold">${item.qty}</span>
                            <button onclick="updateCartQty(${item.id}, 1)" class="px-2.5 py-1 text-xs font-bold bg-gray-100 hover:bg-gray-200">+</button>
                        </div>
                        <button onclick="updateCartQty(${item.id}, -${item.qty})" class="text-gray-400 hover:text-red-500 text-xs p-1">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                `;
                cartItemList.appendChild(itemRow);
            });

            cartTotalPrice.innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
        }

        // CHECKOUT VIA WHATSAPP GENERATOR
        function processCheckoutWA() {
            if (cart.length === 0) {
                showToast("Keranjang belanja masih kosong!", "warning");
                return;
            }

            const name = document.getElementById('buyerName').value.trim();
            const phone = document.getElementById('buyerPhone').value.trim();
            const address = document.getElementById('buyerAddress').value.trim();
            const payment = document.getElementById('paymentMethodSelect').value;

            if (!name || !phone || !address) {
                showToast("Mohon lengkapi Nama, WA, dan Alamat Pengiriman!", "warning");
                return;
            }

            let message = `*ORDEN PEMBELIAN WEBSITE - METI NASABAH*\n`;
            message += `===============================\n`;
            message += `👤 *Nama Pembeli:* ${name}\n`;
            message += `📱 *No. WhatsApp:* ${phone}\n`;
            message += `📍 *Alamat Pengiriman:* ${address}\n`;
            message += `💳 *Metode Pembayaran:* ${payment}\n`;
            message += `===============================\n\n`;
            message += `📦 *DAFTAR ITEM PESANAN:*\n`;

            let grandTotal = 0;
            cart.forEach((item, index) => {
                const subtotal = item.price * item.qty;
                grandTotal += subtotal;
                message += `${index + 1}. *${item.name}*\n`;
                message += `   • Merek: ${item.brand}\n`;
                message += `   • Ukuran: ${item.sizeSelected}\n`;
                message += `   • Qty: ${item.qty} x Rp ${item.price.toLocaleString('id-ID')}\n`;
                message += `   • Subtotal: Rp ${subtotal.toLocaleString('id-ID')}\n\n`;
            });

            message += `-------------------------------\n`;
            message += `💰 *TOTAL PEMBAYARAN:* Rp ${grandTotal.toLocaleString('id-ID')}\n`;
            message += `-------------------------------\n\n`;
            message += `Mohon segera diproses pesanan saya. Terima Kasih METI NASABAH!`;

            const waNumber = "6283890855297";
            const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;

            window.open(waUrl, '_blank');
            closeCartModal();
            cart = [];
            updateCartUI();
            showToast("Pesanan dialihkan ke WhatsApp Admin!", "success");
        }

        // MODAL CONTROLLERS
        function openCartModal() {
            updateCartUI();
            document.getElementById('cartModal').classList.remove('hidden');
        }
        function closeCartModal() {
            document.getElementById('cartModal').classList.add('hidden');
        }
        function openStockModal() {
            document.getElementById('stockModal').classList.remove('hidden');
        }
        function closeStockModal() {
            document.getElementById('stockModal').classList.add('hidden');
        }

        // INPUT STOK BARU (ADD NEW PRODUCT)
        function saveNewProduct(e) {
            e.preventDefault();

            const name = document.getElementById('newProdName').value;
            const brand = document.getElementById('newProdBrand').value;
            const category = document.getElementById('newProdCategory').value;
            const price = parseFloat(document.getElementById('newProdPrice').value);
            const promoPriceVal = document.getElementById('newProdPromoPrice').value;
            const promoPrice = promoPriceVal ? parseFloat(promoPriceVal) : null;
            const sizesInput = document.getElementById('newProdSize').value;
            const sizes = sizesInput.split(',').map(s => s.trim());
            const stock = parseInt(document.getElementById('newProdStock').value);
            const specs = document.getElementById('newProdSpecs').value;
            const imageVal = document.getElementById('newProdImage').value;
            const isPromo = document.getElementById('newProdIsPromo').checked;

            const newProduct = {
                id: Date.now(),
                name: name,
                brand: brand,
                category: category,
                price: price,
                promoPrice: promoPrice,
                sizes: sizes,
                specs: specs,
                stock: stock,
                isPromo: isPromo,
                image: imageVal || 'https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=500&auto=format&fit=crop&q=80'
            };

            // Insert new product into catalog
            products.unshift(newProduct);
            renderProducts();
            
            // Reset form and close modal
            document.getElementById('newProductForm').reset();
            closeStockModal();
            showToast(`Stok baru "${name}" berhasil ditambahkan!`, "success");
        }

        // TOAST NOTIFICATION UTILITY
        function showToast(msg, type = "success") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.innerText = msg;
            
            if (type === "warning") {
                toastIcon.className = "fa-solid fa-triangle-exclamation text-amber-400 text-xl";
            } else {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-xl";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
