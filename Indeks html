        ];

        let cart = [];
        let currentCategoryFilter = 'semua';

        // INITIALIZE APP ON LOAD
        window.onload = function() {
            renderProducts();
        };

        // RENDER PRODUCTS TO PROMO ETALASE AND MAIN CATALOG
        function renderProducts() {
            const promoGrid = document.getElementById('promoGrid');
            const productGrid = document.getElementById('productGrid');
            const noProducts = document.getElementById('noProductsFound');
            const searchKeyword = (document.getElementById('searchInput').value || document.getElementById('searchInputMobile').value).toLowerCase();

            promoGrid.innerHTML = '';
            productGrid.innerHTML = '';

            // Filter logic
            let filtered = products.filter(p => {
                const matchCategory = 
                    currentCategoryFilter === 'semua' ? true :
                    currentCategoryFilter === 'promo' ? p.isPromo :
                    p.category.toLowerCase() === currentCategoryFilter.toLowerCase();
                
                const matchSearch = p.name.toLowerCase().includes(searchKeyword) || 
                                    p.brand.toLowerCase().includes(searchKeyword) ||
                                    p.specs.toLowerCase().includes(searchKeyword) ||
                                    p.category.toLowerCase().includes(searchKeyword);

                return matchCategory && matchSearch;
            });

            // Populate Promo Section (Always display products marked isPromo)
            const promoProducts = products.filter(p => p.isPromo);
            promoProducts.forEach(prod => {
                promoGrid.appendChild(createProductCard(prod, true));
            });

            // Populate Main Grid
            if (filtered.length === 0) {
                noProducts.classList.remove('hidden');
            } else {
                noProducts.classList.add('hidden');
                filtered.forEach(prod => {
                    productGrid.appendChild(createProductCard(prod, false));
                });
            }

            document.getElementById('catalogCountText').innerText = `Menampilkan ${filtered.length} baju berkualitas`;
        }

        // CREATE CARD COMPONENT FOR PRODUCT
        function createProductCard(prod, isPromoEtalase) {
            const card = document.createElement('div');
            card.className = "bg-white rounded-3xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition duration-300 flex flex-col justify-between group relative";
            
            const displayPrice = prod.promoPrice ? prod.promoPrice : prod.price;
            const sizeBadges = prod.sizes.map(s => `<span class="bg-gray-100 text-gray-700 text-[10px] font-semibold px-2 py-0.5 rounded">${s}</span>`).join(' ');
            
            // Stock level status badge
            let stockBadge = '';
            if (prod.stock <= 5 && prod.stock > 0) {
                stockBadge = `<span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Stok Menipis (${prod.stock})</span>`;
            } else if (prod.stock > 5) {
                stockBadge = `<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full"><i class="fa-solid fa-check mr-1"></i>Stok Ready (${prod.stock})</span>`;
            } else {
                stockBadge = `<span class="bg-red-100 text-red-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Stok Habis</span>`;
            }

            card.innerHTML = `
                <div>
                    <!-- Image Wrapper -->
                    <div class="relative h-56 w-full overflow-hidden bg-gray-100">
                        <img src="${prod.image}" alt="${prod.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" onerror="this.src='https://placehold.co/400x400/f3f4f6/9ca3af?text=Foto+Baju'">
                        
                        <!-- Badges Top Left -->
                        <div class="absolute top-3 left-3 flex flex-col gap-1 items-start">
                            ${prod.isPromo ? `<span class="bg-rose-600 text-white font-extrabold text-[10px] px-2.5 py-1 rounded-full uppercase tracking-wider shadow">🔥 Promo</span>` : ''}
                            <span class="bg-gray-900/80 backdrop-blur-md text-white text-[10px] font-medium px-2.5 py-0.5 rounded-full">${prod.category}</span>
                        </div>

                        <!-- Brand Badge Top Right -->
                        <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm text-gray-800 text-[11px] font-bold px-2.5 py-1 rounded-xl shadow-sm">
                            ${prod.brand}
                        </div>
                    </div>

                    <!-- Details Body -->
                    <div class="p-4 space-y-2">
                        <h4 class="font-bold text-gray-900 text-sm md:text-base line-clamp-1 group-hover:text-rose-600 transition">${prod.name}</h4>
                        
                        <!-- Price Display -->
                        <div class="flex items-baseline gap-2">
                            <span class="text-lg font-black text-rose-600">Rp ${displayPrice.toLocaleString('id-ID')}</span>
                            ${prod.promoPrice ? `<span class="text-xs text-gray-400 line-through">Rp ${prod.price.toLocaleString('id-ID')}</span>` : ''}
                        </div>

                        <!-- Sizes -->
                        <div class="pt-1">
                            <span class="text-[11px] text-gray-400 block mb-1 font-medium">Ukuran:</span>
                            <div class="flex flex-wrap gap-1">${sizeBadges}</div>
                        </div>

                        <!-- Specs -->
                        <div class="bg-gray-50 p-2.5 rounded-xl border border-gray-100 mt-2">
                            <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block">Spesifikasi:</span>
                            <p class="text-xs text-gray-600 line-clamp-2 leading-snug">${prod.specs}</p>
                        </div>

                        <!-- Stock status -->
                        <div class="pt-1 flex items-center justify-between">
                            ${stockBadge}
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="p-4 pt-0 grid grid-cols-2 gap-2 mt-2">
                    <button onclick="addToCart(${prod.id})" ${prod.stock <= 0 ? 'disabled' : ''} class="w-full bg-gray-900 hover:bg-rose-600 disabled:bg-gray-300 text-white py-2 px-2 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 transition">
                        <i class="fa-solid fa-cart-plus"></i> + Keranjang
                    </button>
                    <a href="https://wa.me/6283890855297?text=${encodeURIComponent('Halo METI NASABAH, saya mau tanya/beli produk: ' + prod.name + ' (Merek: ' + prod.brand + ') harga Rp ' + displayPrice.toLocaleString('id-ID'))}" target="_blank" class="w-full bg-emerald-50 hover:bg-emerald-100 text-emerald-700 py-2 px-2 rounded-xl font-bold text-xs flex items-center justify-center gap-1 transition border border-emerald-200">
                        <i class="fa-brands fa-whatsapp text-sm"></i> Order WA
                    </a>
                </div>
            `;
